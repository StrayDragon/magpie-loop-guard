{
  "name": "magpie-loop-guard",
  "version": "1.1.0",
  "description": "Break LLM loops as magpie gateway middleware: after N identical replies in a session, refuse the next request, or inject a preset corrective prompt so the model self-corrects (LLM 死循环保护)",
  "type": "module",
  "files": [
    "loop-guard.middleware.js",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-middleware",
    "loop",
    "loop-guard",
    "repeat",
    "guard",
    "preset",
    "llm-gateway"
  ],
  "license": "MIT",
  "author": "StrayDragon",
  "homepage": "https://github.com/StrayDragon/magpie-loop-guard#readme",
  "bugs": "https://github.com/StrayDragon/magpie-loop-guard/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StrayDragon/magpie-loop-guard.git"
  },
  "scripts": {
    "test": "node test.mjs && (cd verify && go run . -file ../loop-guard.middleware.js -cases ../cases.json)"
  },
  "magpie": {
    "middleware": "./loop-guard.middleware.js",
    "options": {
      "targets": [
        "*"
      ],
      "threshold": 5,
      "mode": "reject",
      "models": [
        {
          "name": "dsv41flash-let-me-loop",
          "targets": [
            "*/deepseek-v4.1-flash*"
          ],
          "fragment": true,
          "mode": "inject"
        }
      ]
    }
  }
}
